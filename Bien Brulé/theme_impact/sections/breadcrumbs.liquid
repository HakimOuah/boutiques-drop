{% comment %}
  Section de fil d'Ariane (Breadcrumbs) avec support des metafields pour maillage manuel
{% endcomment %}

{% liquid
  # Récupération des paramètres de la section
  assign home_text = section.settings.home_text | default: 'Accueil'
  assign separator = section.settings.separator
  assign font_size = section.settings.font_size
  assign text_color = section.settings.text_color
  assign current_color = section.settings.current_color
  assign show_home = section.settings.show_home
  assign show_on_homepage = section.settings.show_on_homepage
%}

{% unless template == 'index' and show_on_homepage == false %}
<nav class="breadcrumbs" aria-label="Fil d'Ariane" style="--breadcrumb-font-size: {{ font_size }}px; --breadcrumb-text-color: {{ text_color }}; --breadcrumb-current-color: {{ current_color }};">
  <div class="breadcrumbs__container">
    <ol class="breadcrumbs__list">
      
      {% comment %} Lien Accueil {% endcomment %}
      {% if show_home %}
      <li class="breadcrumbs__item">
        <a href="{{ routes.root_url }}" class="breadcrumbs__link">
          <span>{{ home_text }}</span>
        </a>
        <span class="breadcrumbs__separator" aria-hidden="true">{{ separator }}</span>
      </li>
      {% endif %}

      {% comment %} PAGES PRODUITS {% endcomment %}
      {% if template.name == 'product' %}
        {% comment %} Vérifier si un metafield de breadcrumb personnalisé existe {% endcomment %}
        {% if product.metafields.custom.breadcrumb_path %}
          {% assign breadcrumb_items = product.metafields.custom.breadcrumb_path | split: '|' %}
          {% for item in breadcrumb_items %}
            {% assign item_parts = item | split: '::' %}
            {% assign item_title = item_parts[0] %}
            {% assign item_url = item_parts[1] %}
            
            <li class="breadcrumbs__item">
              <a href="{{ item_url }}" class="breadcrumbs__link">
                <span>{{ item_title }}</span>
              </a>
              <span class="breadcrumbs__separator" aria-hidden="true">{{ separator }}</span>
            </li>
          {% endfor %}
        {% else %}
          {% comment %} Maillage automatique - Afficher TOUTES les collections du produit {% endcomment %}
          {% if product.collections.size > 0 %}
            {% for prod_collection in product.collections %}
              <li class="breadcrumbs__item">
                <a href="{{ prod_collection.url }}" class="breadcrumbs__link">
                  <span>{{ prod_collection.title }}</span>
                </a>
                <span class="breadcrumbs__separator" aria-hidden="true">{{ separator }}</span>
              </li>
            {% endfor %}
          {% endif %}
        {% endif %}

        {% comment %} Page produit actuelle {% endcomment %}
        <li class="breadcrumbs__item breadcrumbs__item--current">
          <span>{{ product.title }}</span>
        </li>

      {% comment %} PAGES COLLECTIONS {% endcomment %}
      {% elsif template.name == 'collection' %}
        {% comment %} Metafield personnalisé pour la collection {% endcomment %}
        {% if collection.metafields.custom.breadcrumb_path %}
          {% assign breadcrumb_items = collection.metafields.custom.breadcrumb_path | split: '|' %}
          {% for item in breadcrumb_items %}
            {% assign item_parts = item | split: '::' %}
            {% assign item_title = item_parts[0] %}
            {% assign item_url = item_parts[1] %}
            
            <li class="breadcrumbs__item">
              <a href="{{ item_url }}" class="breadcrumbs__link">
                <span>{{ item_title }}</span>
              </a>
              <span class="breadcrumbs__separator" aria-hidden="true">{{ separator }}</span>
            </li>
          {% endfor %}
        {% endif %}

        <li class="breadcrumbs__item breadcrumbs__item--current">
          <span>{{ collection.title }}</span>
        </li>

      {% comment %} PAGES BLOG (page hub) {% endcomment %}
      {% elsif template.name == 'blog' %}
        <li class="breadcrumbs__item breadcrumbs__item--current">
          <span>{{ blog.title }}</span>
        </li>

      {% comment %} PAGES ARTICLE DE BLOG {% endcomment %}
      {% elsif template.name == 'article' %}
        <li class="breadcrumbs__item">
          <a href="{{ blog.url }}" class="breadcrumbs__link">
            <span>{{ blog.title }}</span>
          </a>
          <span class="breadcrumbs__separator" aria-hidden="true">{{ separator }}</span>
        </li>

        <li class="breadcrumbs__item breadcrumbs__item--current">
          <span>{{ article.title }}</span>
        </li>

      {% comment %} PAGES STANDARDS {% endcomment %}
      {% elsif template.name == 'page' %}
        <li class="breadcrumbs__item breadcrumbs__item--current">
          <span>{{ page.title }}</span>
        </li>

      {% comment %} PAGE PANIER {% endcomment %}
      {% elsif template.name == 'cart' %}
        <li class="breadcrumbs__item breadcrumbs__item--current">
          <span>Panier</span>
        </li>

      {% comment %} PAGE RECHERCHE {% endcomment %}
      {% elsif template.name == 'search' %}
        <li class="breadcrumbs__item breadcrumbs__item--current">
          <span>Recherche</span>
        </li>
      {% endif %}

    </ol>
  </div>
</nav>
{% endunless %}
<style>
  .breadcrumbs {
    padding: 15px 0;
    font-size: var(--breadcrumb-font-size, 14px);
  }

  .breadcrumbs__container {
    max-width: {{ settings.page_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .breadcrumbs__list {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 8px;
  }

  .breadcrumbs__item {
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  .breadcrumbs__link {
    color: var(--breadcrumb-text-color, #333);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .breadcrumbs__link:hover {
    opacity: 0.7;
    text-decoration: underline;
  }

  .breadcrumbs__separator {
    color: var(--breadcrumb-text-color, #333);
    opacity: 0.5;
    user-select: none;
  }

  .breadcrumbs__item--current span {
    color: var(--breadcrumb-current-color, #333);
    font-weight: bold;
  }

  /* Mobile : scrollable horizontalement */
  @media (max-width: 768px) {
    .breadcrumbs {
      padding: 10px 0;
      font-size: calc(var(--breadcrumb-font-size, 14px) - 2px);
    }

    .breadcrumbs__container {
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none; /* Firefox */
      -ms-overflow-style: none; /* IE et Edge */
      padding: 0 15px;
    }

    .breadcrumbs__container::-webkit-scrollbar {
      display: none; /* Chrome, Safari, Opera */
    }

    .breadcrumbs__list {
      flex-wrap: nowrap;
    }
  }

  /* Desktop : respecte la largeur du thème */
  @media (min-width: 769px) {
    .breadcrumbs__list {
      flex-wrap: wrap;
    }
  }
</style>

{% schema %}
{
  "name": "Fil d'Ariane",
  "tag": "section",
  "class": "section-breadcrumbs",
  "settings": [
    {
      "type": "header",
      "content": "Paramètres généraux"
    },
    {
      "type": "checkbox",
      "id": "show_home",
      "label": "Afficher le lien Accueil",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_homepage",
      "label": "Afficher sur la page d'accueil",
      "default": false,
      "info": "Si décoché, le fil d'ariane ne s'affichera pas sur la page d'accueil"
    },
    {
      "type": "text",
      "id": "home_text",
      "label": "Texte du lien Accueil",
      "default": "Accueil",
      "info": "Laissez vide pour utiliser 'Accueil'. Personnalisez pour optimiser l'ancre (ex: 'Boutique en ligne', 'Nos produits')"
    },
    {
      "type": "header",
      "content": "Apparence"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Taille de police",
      "default": 14
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte",
      "default": "#5A4636"
    },
    {
      "type": "color",
      "id": "current_color",
      "label": "Couleur de la page actuelle",
      "default": "#B5651D",
      "info": "La page actuelle sera en gras avec cette couleur"
    },
    {
      "type": "select",
      "id": "separator",
      "label": "Style du séparateur",
      "options": [
        {
          "value": "/",
          "label": "Slash /"
        },
        {
          "value": ">",
          "label": "Chevron >"
        },
        {
          "value": "›",
          "label": "Chevron simple ›"
        },
        {
          "value": "»",
          "label": "Chevron double »"
        },
        {
          "value": "→",
          "label": "Flèche →"
        },
        {
          "value": "•",
          "label": "Point •"
        },
        {
          "value": "-",
          "label": "Tiret -"
        },
        {
          "value": "|",
          "label": "Barre verticale |"
        }
      ],
      "default": "/"
    },
    {
      "type": "paragraph",
      "content": "💡 Configuration des metafields personnalisés"
    },
    {
      "type": "paragraph",
      "content": "Pour un maillage manuel, créez un metafield 'custom.breadcrumb_path' (type: texte multi-ligne) sur vos produits ou collections."
    },
    {
      "type": "paragraph",
      "content": "Format : Titre1::URL1|Titre2::URL2|Titre3::URL3"
    },
    {
      "type": "paragraph",
      "content": "Exemple : Équipements::/collections/equipements|Sport::/collections/sport"
    }
  ],
  "presets": [
    {
      "name": "Breadcrumbs"
    }
  ]
}
{% endschema %}