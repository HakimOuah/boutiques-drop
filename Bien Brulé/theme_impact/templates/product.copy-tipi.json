-delay:3s; }\n.promo-mobile .slide:nth-child(3){ animation-delay:6s; }\n.promo-mobile .slide:nth-child(4){ animation-delay:9s; }\n\n@keyframes promoFade{\n  0%   { opacity:0; }\n  5%   { opacity:1; }\n  25%  { opacity:1; }\n  30%  { opacity:0; }\n  100% { opacity:0; }\n}\n\n/* >>> Breakpoint mis plus tôt <<< */\n/* Desktop only */\n@media (min-width:1025px){\n  .promo-desktop{ display:flex; }\n  .promo-mobile{ display:none; }\n}\n\n/* Mobile / tablette (active plus tôt) */\n@media (max-width:1024px){\n  .promo-banner{ \n    padding:4px 6px;\n    gap:0; \n    min-height:34px;\n  }\n  .promo-title { font-size:13px; }\n  .promo-badge { font-size:11px; padding:2px 5px; }\n  .promo-strong { font-size:12px; }\n  .promo-info { font-size:12px; }\n  .promo-note { font-size:11px; padding:2px 5px; }\n  .promo-desktop{ display:none; }\n  .promo-mobile{ display:block; }\n}\n</style>\n\n<div class=\"promo-wrap\">\n  <div class=\"promo-banner\" role=\"region\" aria-label=\"Offre Pack d'été\">\n    <!-- Desktop -->\n    <div class=\"promo-desktop\">\n      <div class=\"promo-title\">PACK D’ÉTÉ <span class=\"promo-badge\">JUSQU’AU 15 AOÛT</span></div>\n      <div class=\"promo-strong\">2 ARTICLES = -10€ &nbsp; | &nbsp; 3 ARTICLES = -20€</div>\n      <div class=\"promo-info\">Remise automatique — <em>Stocks limités</em></div>\n      <div class=\"promo-note\">Offre valable sur toute la boutique</div>\n    </div>\n\n    <!-- Mobile -->\n    <div class=\"promo-mobile\" aria-live=\"polite\">\n      <div class=\"slide\"><div class=\"promo-title\">PACK D’ÉTÉ</div><div class=\"promo-badge\">JUSQU’AU 15 AOÛT</div></div>\n      <div class=\"slide\"><div class=\"promo-strong\">2 ARTICLES = -10€ &nbsp; | &nbsp; 3 ARTICLES = -20€</div></div>\n      <div class=\"slide\"><div class=\"promo-info\">Remise automatique — <em>Stocks limités</em></div></div>\n      <div class=\"slide\"><div class=\"promo-note\">Offre spéciale valable sur toute la boutique</div></div>\n    </div>\n  </div>\n</div>\n{% en