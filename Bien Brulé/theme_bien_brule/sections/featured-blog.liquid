{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-article-card.css' | asset_url | stylesheet_tag }}
{{ 'section-featured-blog.css' | asset_url | stylesheet_tag }}

<style>
  {% if section.settings.display_as_card %}
    .featured-blog-wrapper--{{ section.id }} {
      margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
      margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .featured-blog-wrapper--{{ section.id }} {
        margin-top: {{ section.settings.margin_top }}px;
        margin-bottom: {{ section.settings.margin_bottom }}px;
      }
    }
  {% else %}
    .section-{{ section.id }}-padding {
      margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
      margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        margin-top: {{ section.settings.margin_top }}px;
        margin-bottom: {{ section.settings.margin_bottom }}px;
      }
    }
  {% endif %}

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
</style>

{%- liquid
  assign posts_displayed = section.settings.blog.articles_count
  if section.settings.post_limit <= section.settings.blog.articles_count or section.settings.post_limit <= 4
    assign posts_exceed_limit = true
    assign posts_displayed = section.settings.post_limit
  endif

  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign show_mobile_slider = false
  if section.settings.enable_mobile_slider and posts_displayed > columns_mobile_int
    assign show_mobile_slider = true
  endif

  assign show_desktop_slider = false
  if section.settings.enable_desktop_slider and posts_displayed > section.settings.columns_desktop
    assign show_desktop_slider = true
  endif
-%}

{% if section.settings.display_as_card %}
  <div class="page-width">
    <div class="featured-blog-wrapper featured-blog-wrapper--{{ section.id }} content-container content-container--card color-{{ section.settings.color_scheme | default: 'background-1' }} gradient">
      <div class="blog{% if section.settings.heading == blank %} no-heading{% endif %}" id="FeaturedBlog-{{ section.id }}">
        <div class="isolate{% if posts_displayed < 3 %} page-width-tablet{% endif %} section-{{ section.id }}-padding">
{% else %}
  <div class="blog color-{{ section.settings.color_scheme }} gradient{% if section.settings.heading == blank %} no-heading{% endif %}" id="FeaturedBlog-{{ section.id }}">
    <div class="page-width isolate{% if posts_displayed < 3 %} page-width-tablet{% endif %} section-{{ section.id }}-padding">
{% endif %}
    {%- unless section.settings.heading == blank -%}
      <div class="title-wrapper-with-link{% if posts_displayed > 2 %} title-wrapper--self-padded-tablet-down{% else %} title-wrapper--self-padded-mobile{% endif %} 
      title-wrapper--no-top-margin {{ section.settings.text_alignment }}">
        <{{ section.settings.hn }}
          id="SectionHeading-{{ section.id }}"
          class="blog__title inline-richtext {{ section.settings.heading_size }}"
        >
          {{ section.settings.heading }}
        </{{ section.settings.hn }}>

        {%- if section.settings.blog != blank
          and section.settings.show_view_all
          and section.settings.post_limit < section.settings.blog.articles_count
        -%}
          <a
            href="{{ section.settings.blog.url }}"
            class="link underlined-link large-up-hide"
          >
            {{ 'sections.featured_blog.view_all' | t }}
          </a>
        {%- endif -%}
      </div>
    {%- endunless -%}

      <slider-element 
        class="slider-component__show-option featured-blog-slider{% if section.settings.hide_dots %} no-dots{% endif %}"
        id="featured-blog--{{ section.id }}"
        data-slide-per-view-desktop="{{ section.settings.columns_desktop }}"
        data-slide-per-view-tablet="{{ section.settings.columns_tablet }}"
        data-slide-per-view-mobile="{{ section.settings.columns_mobile }}"
        data-enabled-desktop="{{ show_desktop_slider }}"
        data-enabled-mobile="{{ show_mobile_slider }}"
      >
        <div class="keen-slider grid-slider grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down">
          {%- if section.settings.blog != blank and section.settings.blog.articles_count > 0 -%}
            {%- for article in section.settings.blog.articles limit: section.settings.post_limit -%}
              {% if article.image != blank %}
                <div
                  id="Slide-{{ section.id }}-{{ forloop.index }}"
                  class="blog__post grid__item article keen-slider__slide"
                >
                  {% render 'article-card',
                    blog: section.settings.blog,
                    article: article,
                    media_aspect_ratio: 1.66,
                    show_image: true,
                    show_date: section.settings.show_date,
                    show_author: section.settings.show_author,
                    truncate_title: section.settings.truncate_title,
                    show_excerpt: true,
                    hn: section.settings.card_hn
                  %}
                </div>
              {% endif %}
            {%- endfor -%}
          {%- else -%}
            {% for i in (1..section.settings.post_limit) -%}
              {%- assign placeholder_image_index = forloop.index0 | modulo: 3 | plus: 1 -%} 
              {%- assign placeholder_image = 'blog-apparel-' | append: placeholder_image_index -%} 
              <div
                id="Slide-{{ section.id }}-{{ forloop.index }}"
                class="blog__post grid__item article keen-slider__slide"
              >
                <div class="article-card-wrapper card-wrapper">
                  <div class="card article-card card--{{ settings.blog_card_style }}
                      {% if settings.blog_card_style == 'card' %} color-{{ settings.blog_card_color_scheme }} gradient{% endif %}
                      {% if section.settings.show_image %} card--media{% else %} card--text{% endif %}"
                    style=" {% if settings.blog_card_style == 'standard' %} --ratio-percent: 100%;{% elsif settings.blog_card_style == 'card' %} --ratio-percent: 0%;{% endif %}"
                  >
                    <div class="card__inner{% if settings.blog_card_style == 'standard' %} color-{{ settings.blog_card_color_scheme }} gradient{% endif %} ratio"
                      style="--ratio-percent: 80%;"
                    >
                      {%- if section.settings.show_image == true -%}
                        <div class="article-card__image-wrapper card__media">
                          <div class="article-card__image media">
                            {{ placeholder_image | placeholder_svg_tag: 'blog-placeholder-svg' }}
                          </div>
                        </div>
                      {%- endif -%}
                      <div class="card__content">
                        <div class="card__information">
                          <{{ section.settings.card_hn }} class="card__heading">
                            {{ 'sections.featured_blog.onboarding_title' | t }}
                          </{{ section.settings.card_hn }}>
                          <p class="article-card__excerpt rte-width">
                            {{ 'sections.featured_blog.onboarding_content' | t }}
                          </p>
                        </div> 
                      </div>
                    </div>
                    <div class="card__content">
                      <div class="card__information">
                        <{{ section.settings.card_hn }} class="card__heading">
                          {{ 'sections.featured_blog.onboarding_title' | t }}
                        </{{ section.settings.card_hn }}>
                        <p class="article-card__excerpt rte-width">
                          {{ 'sections.featured_blog.onboarding_content' | t }}
                        </p>
                      </div> 
                    </div>
                  </div> 
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
        <div class="slider__navigation">
          <div class="slider__navigation--inner {{ section.settings.text_alignment }}">
          </div>
        </div>
      </slider-element>

      {%- if section.settings.show_view_all and section.settings.post_limit < section.settings.blog.articles_count -%}
        <div
          class="blog__view-all center small-hide medium-hide"
        >
          <a
            href="{{ section.settings.blog.url }}"
            id="ViewAll-{{ section.id }}"
            class="blog__button button"
            aria-labelledby="ViewAll-{{ section.id }} SectionHeading-{{ section.id }}"
          >
            <span>{{ 'sections.featured_blog.view_all' | t }}</span>
          </a>
        </div>
      {%- endif -%}
{% if section.settings.display_as_card %}
        </div>
      </div>
    </div>
  </div>
{% else %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "t:sections.featured-blog.name",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.featured-blog.settings.header_content.content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Blog posts",
      "label": "t:sections.featured-blog.settings.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "hn",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.hn.label",
      "info": "t:sections.all.hn.info"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:settings_schema.global.settings.text_alignment.label",
      "options": [
        {
          "value": "left",
          "label": "t:settings_schema.global.settings.text_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:settings_schema.global.settings.text_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:settings_schema.global.settings.text_alignment.options__3.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.featured-blog.settings.header_blog.content"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "t:sections.featured-blog.settings.blog.label"
    },
    {
      "type": "range",
      "id": "post_limit",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "t:sections.featured-blog.settings.post_limit.label"
    },
    {
      "type": "header",
      "content": "t:sections.featured-blog.settings.header_layout.content"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "t:sections.featured-blog.settings.columns_desktop.label"
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "t:sections.featured-blog.settings.columns_tablet.label"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.featured-blog.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.featured-blog.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.featured-blog.settings.columns_mobile.options__2.label"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_desktop_slider",
      "label": "t:sections.featured-blog.settings.enable_desktop_slider.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_slider",
      "default": false,
      "label": "t:sections.featured-blog.settings.enable_mobile_slider.label"
    },
    {
      "type": "header",
      "content": "t:sections.featured-blog.settings.header_blog_post_card.content"
    },
    {
      "type": "paragraph",
      "content": "t:sections.featured-blog.settings.card_paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "truncate_title",
      "label": "t:sections.featured-blog.settings.truncate_title.label",
      "info": "t:sections.featured-blog.settings.truncate_title.info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "default": true,
      "label": "t:sections.featured-blog.settings.show_date.label"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "default": false,
      "label": "t:sections.featured-blog.settings.show_author.label"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "t:sections.featured-blog.settings.show_view_all.label"
    },
    {
      "type": "select",
      "id": "card_hn",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.card_hn.label",
      "info": "t:sections.all.hn.info"
    },
    {
      "type": "header",
      "content": "t:sections.featured-blog.settings.header_navigation.content"
    },
    {
      "type": "checkbox",
      "id": "hide_dots",
      "label": "t:sections.all.slider.hide_dots.label"
    },
    {
      "type": "header",
      "content": "t:sections.featured-blog.settings.header_section_style.content"
    },
    {
      "type": "checkbox",
      "id": "display_as_card",
      "label": "t:sections.slideshow.settings.display_as_card.label",
      "info": "t:sections.slideshow.settings.display_as_card.info",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.margin.margin_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.margin.margin_bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured-blog.presets.name"
    }
  ]
}
{% endschema %}
