{% if settings.enable_special_theme and settings.special_theme == "halloween" %}
	{% if cart.item_count == 0 %}
		<img src="{{ 'trick-or-treat.png' | asset_url }}" class="icon icon-cart-thin icon-trick-or-treat" width="100" height="500" loading="lazy"/>
	{% else %}
		<img src="{{ 'trick-or-treat-full.png' | asset_url }}" class="icon icon-cart-thin icon-trick-or-treat" width="100" height="500" loading="lazy"/>
	{% endif %}
{% elsif settings.enable_special_theme and settings.special_theme == "christmas" %}
	<img src="{{ 'gift.png' | asset_url }}" class="icon icon-cart-thin icon-trick-or-treat" width="100" height="500" loading="lazy"/>
{% else %}
<svg class="icon icon-cart-thin" viewBox="0 0 20 21" fill="none">
	<path d="M1.5 20.5h17v-16h-17v16z"></path>
	<path d="M13.5 8V4A3.5 3.5 0 0010 .5v0A3.5 3.5 0 006.5 4v4"></path>
</svg>
{% endif %}