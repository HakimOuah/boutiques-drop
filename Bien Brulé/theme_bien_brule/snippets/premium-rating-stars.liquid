{% liquid
    assign rating = rating | plus: 0
    assign color = "#00B87C"

    if rating <= 1
     assign color = "#FF3823"
    elsif rating <= 2
     assign color = "#FF8622"
    elsif rating <= 3
     assign color = "#FFCD00"
    elsif rating <= 4
     assign color = "#73D010"
    endif
%}

<svg role="img" viewBox="0 0 251 46" xmlns="http://www.w3.org/2000/svg" style="">
    <title id="starRating" lang="en-US">{{ rating }} out of 5 star rating</title>
    <g class="premium-star">
        <path class="premium-star__canvas" fill="{{ color }}" d="M0 46.330002h46.375586V0H0z"></path>
        <path class="premium-star__shape" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" fill="#FFF" transform="translate(2.1875, 2.165) scale(1.75)"></path>
    </g>
    <g class="premium-star">
        {% if rating >= 2 %}
            <path class="premium-star__canvas" fill="{{ color }}" d="M51.24816 46.330002h46.375587V0H51.248161z"></path>
        {% else %}
            <path class="premium-star__canvas" fill="#dddde7" d="M51.24816 46.330002h46.375587V0H51.248161z"></path>
            <path class="premium-star__canvas--half" fill="{{ color }}" d="M51.24816 46.330002h23.187793V0H51.248161z"></path>
        {% endif %}
        <path class="premium-star__shape" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" fill="#FFF" transform="translate(53.4355, 2.165) scale(1.75)"></path>
    </g>
    <g class="premium-star">
        {% if rating >= 3 %}
            <path class="premium-star__canvas" fill="{{ color }}" d="M102.532209 46.330002h46.375586V0h-46.375586z"></path>
        {% elsif rating > 2 %}
            <path class="premium-star__canvas" fill="#dddde7" d="M102.532209 46.330002h46.375586V0h-46.375586z"></path>
            <path class="premium-star__canvas--half" fill="{{ color }}" d="M102.532209 46.330002h23.187793V0h-23.187793z"></path>
        {% else %}
            <path class="premium-star__canvas" fill="#dddde7" d="M102.532209 46.330002h46.375586V0h-46.375586z"></path>
        {% endif %}
        <path class="premium-star__shape" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" fill="#FFF" transform="translate(104.720, 2.165) scale(1.75)"></path>
    </g>
    <g class="premium-star">
        {% if rating >= 4 %}
            <path class="premium-star__canvas" fill="{{ color }}" d="M153.815458 46.330002h46.375586V0h-46.375586z"></path>
        {% elsif rating > 3 %}
            <path class="premium-star__canvas" fill="#dddde7" d="M153.815458 46.330002h46.375586V0h-46.375586z"></path>
            <path class="premium-star__canvas--half" fill="{{ color }}" d="M153.815458 46.330002h23.187793V0h-23.187793z"></path>
        {% else %}
            <path class="premium-star__canvas" fill="#dddde7" d="M153.815458 46.330002h46.375586V0h-46.375586z"></path>
        {% endif %}
        <path class="premium-star__shape" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" fill="#FFF" transform="translate(156.003, 2.165) scale(1.75)"></path>
    </g>
    <g class="premium-star">
        {% if rating >= 5 %}
            <path class="premium-star__canvas" fill="{{ color }}" d="M205.064416 46.330002h46.375587V0h-46.375587z"></path>
        {% elsif rating > 4 %}
            <path class="premium-star__canvas" fill="#dddde7" d="M205.064416 46.330002h46.375587V0h-46.375587z"></path>
            <path class="premium-star__canvas--half" fill="{{ color }}" d="M205.064416 46.330002h23.187793V0h-23.187793z"></path>
        {% else %}
            <path class="premium-star__canvas" fill="#dddde7" d="M205.064416 46.330002h46.375587V0h-46.375587z"></path>
            <path class="premium-star__canvas--half" fill="#dddde7" d="M205.064416 46.330002h23.187793V0h-23.187793z"></path>
        {% endif %}
        <path class="premium-star__shape" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z" fill="#FFF" transform="translate(207.252, 2.165) scale(1.75)"></path>
    </g>
</svg>
