{
  "type": "object",
  "description": "Recommandation technique. Chaque motif porte sa preuve ou le verdict est nul.",
  "properties": {
    "niche": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "PRODUIT PUR",
        "UNIVERS"
      ]
    },
    "verdict": {
      "enum": [
        "TECHNICAL_PASS",
        "TECHNICAL_WATCH",
        "TECHNICAL_FAIL",
        "TECHNICAL_INCONCLUSIVE"
      ]
    },
    "motifs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "affirmation": {
            "type": "string",
            "minLength": 10
          },
          "poids": {
            "enum": [
              "decisif",
              "appui",
              "signal_faible"
            ]
          },
          "preuve": {
            "type": "object",
            "description": "Preuve vérifiable. Sans elle, l'affirmation est rejetée.",
            "properties": {
              "type": {
                "enum": [
                  "url",
                  "mention_legale",
                  "citation",
                  "mesure",
                  "capture"
                ],
                "description": "mesure = sortie d'un outil déterministe (kw_dfs, ShopifyQL)."
              },
              "source": {
                "type": "string",
                "minLength": 8,
                "description": "URL complète, chemin de fichier, ou commande exacte."
              },
              "extrait": {
                "type": "string",
                "minLength": 3,
                "description": "Le passage qui soutient l'affirmation, recopié mot pour mot."
              },
              "date": {
                "type": "string",
                "description": "AAAA-MM-JJ de la lecture."
              }
            },
            "required": [
              "type",
              "source",
              "extrait"
            ]
          }
        },
        "required": [
          "affirmation",
          "poids",
          "preuve"
        ]
      }
    },
    "contre_arguments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ce qui plaide contre ton propre verdict. Obligatoire même vide."
    },
    "confiance": {
      "enum": [
        "haute",
        "moyenne",
        "faible"
      ]
    },
    "non_fait": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requete_decisive": {
      "type": "object",
      "description": "Nommer la requête de référence ; en UNIVERS, elle ne remplace pas la consolidation par familles.",
      "properties": {
        "requete": {
          "type": "string"
        },
        "motif_du_choix": {
          "type": "string",
          "minLength": 10,
          "description": "Intention d'achat la plus proche du produit vendu, puis volume et panier ensemble."
        },
        "requetes_ecartees": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "requete": {
                "type": "string"
              },
              "motif": {
                "type": "string"
              }
            },
            "required": [
              "requete",
              "motif"
            ]
          }
        },
        "expediabilite": {
          "type": "object",
          "description": "Encombrement × origine. Hors gabarit + Chine = exclu ; hors gabarit + UE = tenable ; origine inconnue = REVIEW obligatoire.",
          "properties": {
            "hors_gabarit": {
              "type": "boolean",
              "description": "Le produit ne rentre pas dans un colis standard."
            },
            "origine": {
              "enum": [
                "ue",
                "chine",
                "inconnue"
              ]
            },
            "consequence": {
              "enum": [
                "eligible",
                "exclu",
                "review_obligatoire"
              ]
            }
          },
          "required": [
            "hors_gabarit",
            "origine",
            "consequence"
          ]
        }
      },
      "required": [
        "requete",
        "motif_du_choix",
        "requetes_ecartees",
        "expediabilite"
      ]
    },
    "pistes_adjacentes": {
      "type": "array",
      "maxItems": 2,
      "description": "Droit de contre-proposition. On propose, on ne substitue pas : le verdict sur le marché demandé reste rendu en entier. Une piste sans volume mesuré ET sans bande de prix n'a pas sa place ici.",
      "items": {
        "type": "object",
        "properties": {
          "produit": {
            "type": "string"
          },
          "volume_mensuel": {
            "type": "integer",
            "description": "Volume du `mot_cle_exact`, relevé tel quel. Un volume de niveau supérieur attribué à une longue traîne est la faute la plus courante."
          },
          "bande_de_prix_eur": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "pourquoi_elle_tient": {
            "type": "string",
            "minLength": 10,
            "description": "Volume ET panier. L'un sans l'autre ne suffit pas."
          },
          "preuve": {
            "type": "object",
            "description": "Preuve vérifiable. Sans elle, l'affirmation est rejetée.",
            "properties": {
              "type": {
                "enum": [
                  "url",
                  "mention_legale",
                  "citation",
                  "mesure",
                  "capture"
                ],
                "description": "mesure = sortie d'un outil déterministe (kw_dfs, ShopifyQL)."
              },
              "source": {
                "type": "string",
                "minLength": 8,
                "description": "URL complète, chemin de fichier, ou commande exacte."
              },
              "extrait": {
                "type": "string",
                "minLength": 3,
                "description": "Le passage qui soutient l'affirmation, recopié mot pour mot."
              },
              "date": {
                "type": "string",
                "description": "AAAA-MM-JJ de la lecture."
              }
            },
            "required": [
              "type",
              "source",
              "extrait"
            ]
          },
          "mot_cle_exact": {
            "type": "string",
            "description": "La chaîne EXACTE dont le volume est annoncé, telle qu'interrogée. Sert à re-vérifier le chiffre en une requête. Ne jamais donner le volume d'un mot parent pour celui d'une longue traîne."
          },
          "expediabilite": {
            "type": "object",
            "description": "Encombrement × origine. Hors gabarit + Chine = exclu ; hors gabarit + UE = tenable ; origine inconnue = REVIEW obligatoire.",
            "properties": {
              "hors_gabarit": {
                "type": "boolean",
                "description": "Le produit ne rentre pas dans un colis standard."
              },
              "origine": {
                "enum": [
                  "ue",
                  "chine",
                  "inconnue"
                ]
              },
              "consequence": {
                "enum": [
                  "eligible",
                  "exclu",
                  "review_obligatoire"
                ]
              }
            },
            "required": [
              "hors_gabarit",
              "origine",
              "consequence"
            ]
          }
        },
        "required": [
          "produit",
          "mot_cle_exact",
          "volume_mensuel",
          "bande_de_prix_eur",
          "pourquoi_elle_tient",
          "preuve"
        ]
      }
    },
    "critere_prix": {
      "type": "object",
      "description": "Critère B, rendu auditable. Le plancher est comparable, jamais absolu.",
      "properties": {
        "plancher_eur": {
          "type": "number"
        },
        "produit_du_plancher": {
          "type": "string",
          "minLength": 3,
          "description": "Le produit exact qui porte ce prix. Un plancher sans son porteur n'est pas vérifiable."
        },
        "vendeur_du_plancher": {
          "type": "string",
          "minLength": 2
        },
        "plafond_eur": {
          "type": "number"
        },
        "rapport_plafond_plancher": {
          "type": "number",
          "description": "Au-delà de ~4, le plancher n'est presque jamais comparable : le reprendre."
        },
        "exclus_du_calcul": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Pièces, accessoires, marques officielles, marques à récit, bas de gamme marketplace."
        },
        "cout_rendu_eur": {
          "type": [
            "number",
            "null"
          ],
          "description": "null = inconnu, donc verdict plafonné à REVIEW."
        },
        "verrou": {
          "enum": [
            "oui",
            "non",
            "inconnu"
          ]
        },
        "preuve": {
          "type": "object",
          "description": "Preuve vérifiable. Sans elle, l'affirmation est rejetée.",
          "properties": {
            "type": {
              "enum": [
                "url",
                "mention_legale",
                "citation",
                "mesure",
                "capture"
              ],
              "description": "mesure = sortie d'un outil déterministe (kw_dfs, ShopifyQL)."
            },
            "source": {
              "type": "string",
              "minLength": 8,
              "description": "URL complète, chemin de fichier, ou commande exacte."
            },
            "extrait": {
              "type": "string",
              "minLength": 3,
              "description": "Le passage qui soutient l'affirmation, recopié mot pour mot."
            },
            "date": {
              "type": "string",
              "description": "AAAA-MM-JJ de la lecture."
            }
          },
          "required": [
            "type",
            "source",
            "extrait"
          ]
        }
      },
      "required": [
        "plancher_eur",
        "produit_du_plancher",
        "vendeur_du_plancher",
        "verrou",
        "preuve"
      ]
    },
    "consolidation_familles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "famille": {
            "type": "string"
          },
          "volume_net": {
            "type": [
              "integer",
              "null"
            ]
          },
          "preuve": {
            "type": "string"
          }
        },
        "required": [
          "famille",
          "volume_net",
          "preuve"
        ]
      }
    }
  },
  "required": [
    "niche",
    "verdict",
    "requete_decisive",
    "motifs",
    "contre_arguments",
    "confiance",
    "non_fait",
    "critere_prix",
    "mode"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "verdict-niche",
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "UNIVERS"
          }
        }
      },
      "then": {
        "required": [
          "consolidation_familles"
        ],
        "properties": {
          "consolidation_familles": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
