                  },
                  "blocks": {
                    "text_yarNag": {
                      "type": "text",
                      "settings": {
                        "show_on_display": "desktop_and_mobile",
                        "text": "<p>Dépliée : 197 × 57 cm au sol, pour 72,5 cm de hauteur. Repliée (112 × 56 × 28,5 cm), elle se glisse sous un lit ou se range contre un mur.</p>",
                        "text_style": "paragraph",
