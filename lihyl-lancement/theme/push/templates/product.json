                  },
                  "blocks": {
                    "text_FP3XGi": {
                      "type": "text",
                      "settings": {
                        "show_on_display": "desktop_and_mobile",
                        "text": "<p>Commande préparée sous 24-48 h, puis 5 à 9 jours ouvrés de livraison offerte partout en France, depuis notre stock européen — sans frais de douane.</p>",
